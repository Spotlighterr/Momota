{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "rootDir": ".",
    "outDir": "build/js",
    "strict": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "moduleDetection": "legacy"
  },
  "include": [
    "browser/**/*.ts",
    "inspect-code.ts",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ]
}
